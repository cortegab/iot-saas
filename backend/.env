# iot-saas backend configuration — for running the API/worker OUTSIDE Docker
# (per CLAUDE.md §8). Copy to backend/.env and adjust as needed: cp .env.example .env
#
# Connects to the infra/docker-compose.yml services via their published localhost ports,
# not the compose network service names (compare infra/.env.example).

# ── PostgreSQL / TimescaleDB ────────────────────────────────────────────────
# Admin/migration URL — role `iot` (superuser). Read only by alembic/env.py; the running
# app never holds superuser credentials.
DATABASE_URL=postgresql+asyncpg://iot:iot_dev_password@127.0.0.1:5432/iot

# Runtime URL — role `iot_app` (NOSUPERUSER NOBYPASSRLS), so RLS policies actually apply.
# Requires the one-time `iot_app` role bootstrap documented in CLAUDE.md §8.
APP_DATABASE_URL=postgresql+asyncpg://iot_app:iot_app_dev_password@127.0.0.1:5432/iot

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── EMQX (MQTT) ─────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Dev-only value. Generate a real secret for anything beyond local dev.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
