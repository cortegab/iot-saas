# Local override for real secrets that shouldn't join backend/.env's
# committed dev placeholders. Copy to backend/.env.local (gitignored) and
# fill in — it overrides matching keys from .env (see config.py's
# Settings.model_config: env_file=(".env", ".env.local")).
#
# Everything else for SMTP (host/port/username/from/tls) is non-secret and
# already set in the committed backend/.env — this file only needs the
# actual mailbox password.
SMTP_PASSWORD=
