{
  "name": "iodriven-mobile",
  "version": "0.5.1",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "doctor": "expo-doctor",
    "build:apk": "CI=1 expo prebuild -p android --clean --no-install && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a && echo \"APK: mobile/android/app/build/outputs/apk/release/app-release.apk\"",
    "build:aab": "CI=1 expo prebuild -p android --clean --no-install && cd android && ./gradlew bundleRelease && echo \"AAB: mobile/android/app/build/outputs/bundle/release/app-release.aab\"",
    "upload-key": "bash scripts/create-upload-key.sh"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@iodriven/shared": "workspace:*",
    "@orbital-systems/react-native-esp-idf-provisioning": "0.6.1",
    "expo": "~58.0.23",
    "expo-camera": "58.0.11",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-notifications": "58.1.6",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "1.61.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "swr": "^2.5.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "~22.10.7",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  }
}
