# iot-saas — PRODUCTION environment template.
#
# Copy on the VPS (never commit the real file): cp .env.prod.example .env.prod
# Then replace every "CHANGE_ME" with a real, unique, random value —
#   openssl rand -hex 32
# generates a good one for each secret. Do not reuse a dev secret in prod, and
# do not reuse one secret for two different purposes below.
#
# infra/.env.prod is git-ignored. Treat it like the credential it is: readable
# only by the deploy user (chmod 600), never pasted into a chat, ticket, or log.

# ── Domains (DNS A records must point at this VPS before cert issuance) ────
DOMAIN_APP=app.yourdomain.com
DOMAIN_API=api.yourdomain.com
DOMAIN_MQTT=mqtt.yourdomain.com
LETSENCRYPT_EMAIL=you@yourdomain.com

# ── PostgreSQL / TimescaleDB ────────────────────────────────────────────────
POSTGRES_USER=iot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=iot

# Admin/migration URL (role `iot`, superuser) — used only to run
# `alembic upgrade head`, never by the running api/worker.
DATABASE_URL=postgresql+asyncpg://iot:CHANGE_ME@timescaledb:5432/iot

# Runtime URL (role `iot_app`, NOSUPERUSER NOBYPASSRLS) — what api/worker
# actually connect as, so RLS policies apply. The `iot_app` role must be
# created once per CLAUDE.md §8 / infra/PROD_DEPLOY.md before first start.
APP_DATABASE_URL=postgresql+asyncpg://iot_app:CHANGE_ME@timescaledb:5432/iot

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── EMQX (MQTT) ─────────────────────────────────────────────────────────────
# Worker connects internally, plaintext, over the compose network only —
# never exposed to the host or internet (see docker-compose.prod.yml).
MQTT_HOST=emqx
MQTT_PORT=1883
EMQX_NODE_COOKIE=CHANGE_ME
EMQX_DASHBOARD_PASSWORD=CHANGE_ME

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Ingestion — EMQX HTTP auth callbacks ────────────────────────────────────
# Must match the value baked into infra/emqx/emqx.prod.conf (generated from
# emqx.prod.conf.template by scripts/render-emqx-conf.sh — EMQX does not
# support env-var interpolation inside authn/authz headers, see that
# template's comment for why).
EMQX_AUTH_SHARED_SECRET=CHANGE_ME

# The worker's own MQTT identity — a fixed system credential, not a device.
MQTT_WORKER_USERNAME=__worker__
MQTT_WORKER_PASSWORD=CHANGE_ME

# Storage-path batched writer: flush whichever comes first.
TELEMETRY_BATCH_SIZE=500
TELEMETRY_FLUSH_INTERVAL_MS=1000

# ── Frontend ────────────────────────────────────────────────────────────────
# Public HTTPS URL of the API, baked into the frontend build at image-build
# time (see frontend/Dockerfile.prod) — changing it requires a rebuild.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Browser origin(s) allowed to call the API (app/main.py's CORSMiddleware).
# Comma-separated, no trailing slash. Must match DOMAIN_APP above exactly
# (scheme + host), or the browser's preflight OPTIONS request gets rejected.
CORS_ALLOW_ORIGINS=https://app.yourdomain.com
