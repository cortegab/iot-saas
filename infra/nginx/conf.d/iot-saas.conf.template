# Site config template — rendered to iot-saas.conf by
# scripts/render-prod-config.sh (envsubst), which is git-ignored because the
# rendered file bakes in your real domain names. Edit this template, not the
# generated file.
#
# DOMAIN_APP is the canonical app host — set it to your apex (e.g.
# iodriven.tech). www.<DOMAIN_APP> and app.<DOMAIN_APP> 301 to it. One
# certificate, five SANs (apex + www + app + api + mqtt — see
# infra/PROD_DEPLOY.md's certbot step), so a single renewal keeps nginx's
# server blocks AND EMQX's MQTT TLS listener valid at once.

# ── ACME challenge + HTTP → HTTPS redirect, every hostname ─────────────────
server {
    listen 80;
    server_name ${DOMAIN_APP} www.${DOMAIN_APP} app.${DOMAIN_APP} ${DOMAIN_API};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── Canonical-host redirect: www / app subdomain → apex ───────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN_APP} app.${DOMAIN_APP};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_API}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_API}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    return 301 https://${DOMAIN_APP}$request_uri;
}

# ── Frontend (Next.js) — served on the canonical apex host ─────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_APP};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_API}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_API}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ── API (FastAPI: REST + /ws WebSocket) ─────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_API};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_API}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_API}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    location / {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrade for /ws (app/realtime/router.py) — harmless on
        # plain REST requests, since $connection_upgrade is "close" for those.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
}
