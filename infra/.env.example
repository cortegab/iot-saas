# iot-saas dev stack configuration.
# Copy to infra/.env (git-ignored) and adjust as needed:  cp infra/.env.example infra/.env
# Docker Compose auto-loads infra/.env for the ${VAR} interpolation in docker-compose.yml.

# ── PostgreSQL / TimescaleDB ────────────────────────────────────────────────
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_dev_password
POSTGRES_DB=iot

# Admin/migration URL (role `iot`, superuser) — consumed by the backend only to run
# `alembic upgrade head`. Host is the compose service name.
DATABASE_URL=postgresql+asyncpg://iot:iot_dev_password@timescaledb:5432/iot

# Runtime URL (role `iot_app`, NOSUPERUSER NOBYPASSRLS) — consumed by the running api/worker
# for every request-serving query, so RLS policies actually apply. Requires the one-time
# `iot_app` role bootstrap documented in CLAUDE.md §8 before the api/worker containers can
# connect.
APP_DATABASE_URL=postgresql+asyncpg://iot_app:iot_app_dev_password@timescaledb:5432/iot

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── EMQX (MQTT) ─────────────────────────────────────────────────────────────
# Backend connects over the compose network by service name.
MQTT_HOST=emqx
MQTT_PORT=1883
EMQX_NODE_COOKIE=iot-saas-dev-cookie
# Dashboard login is `admin` / this password (http://localhost:18083). Change on first login.
EMQX_DASHBOARD_PASSWORD=public

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Dev-only value. Generate a real secret before this configuration is ever used beyond
# local dev.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Ingestion (Phase 2) ────────────────────────────────────────────────────
# Shared secret EMQX sends (infra/emqx/emqx.conf) when calling back into the
# api container to authenticate/authorize MQTT clients. Dev-only value —
# generate a real secret before this ever runs beyond local dev.
EMQX_AUTH_SHARED_SECRET=dev-only-change-me

# The worker's own MQTT identity — not a device, a fixed system credential
# with subscribe-only access across every tenant's telemetry topics.
MQTT_WORKER_USERNAME=__worker__
MQTT_WORKER_PASSWORD=dev-only-change-me

# Storage-path batched writer: flush whichever comes first.
TELEMETRY_BATCH_SIZE=500
TELEMETRY_FLUSH_INTERVAL_MS=1000

# ── Frontend ────────────────────────────────────────────────────────────────
# Browser-side URL — points at the host-published API port, not the internal network.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Dev tooling (profile: tools) ────────────────────────────────────────────
PGADMIN_EMAIL=admin@iot-saas.local
PGADMIN_PASSWORD=admin
