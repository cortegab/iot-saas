# iot-saas dev stack configuration.
# Copy to infra/.env (git-ignored) and adjust as needed:  cp infra/.env.example infra/.env
# Docker Compose auto-loads infra/.env for the ${VAR} interpolation in docker-compose.yml.

# ── PostgreSQL / TimescaleDB ────────────────────────────────────────────────
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_dev_password
POSTGRES_DB=iot

# Consumed by the backend (api + worker). Host is the compose service name.
DATABASE_URL=postgresql+asyncpg://iot:iot_dev_password@timescaledb:5432/iot

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── EMQX (MQTT) ─────────────────────────────────────────────────────────────
# Backend connects over the compose network by service name.
MQTT_HOST=emqx
MQTT_PORT=1883
EMQX_NODE_COOKIE=iot-saas-dev-cookie
# Dashboard login is `admin` / this password (http://localhost:18083). Change on first login.
EMQX_DASHBOARD_PASSWORD=public

# ── Frontend ────────────────────────────────────────────────────────────────
# Browser-side URL — points at the host-published API port, not the internal network.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Dev tooling (profile: tools) ────────────────────────────────────────────
PGADMIN_EMAIL=admin@iot-saas.local
PGADMIN_PASSWORD=admin
