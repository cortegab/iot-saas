{
  "name": "@iodriven/shared",
  "version": "0.0.1",
  "private": true,
  "description": "What the web app and the mobile app share: the API types generated from the backend's OpenAPI schema, and pure helpers (no DOM, no React, no I/O).",
  "type": "module",
  "exports": {
    "./api": "./src/api.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "codegen": "openapi-typescript http://localhost:8000/openapi.json -o src/api.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "5.7.3",
    "vitest": "^3.2.7"
  }
}
