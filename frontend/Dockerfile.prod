# Production image for the Next.js frontend. Built from the repo root (the
# pnpm workspace, root .dockerignore). Multi-stage: build with the full
# dependency tree, ship only the Next.js "standalone" output (self-contained
# server + the subset of node_modules it actually traces as used) plus the
# static assets. Much smaller than the dev image and needs no bind mount.

FROM node:20-alpine AS deps
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json frontend/
# One line per workspace package the web app uses (COPY globs flatten paths).
COPY packages/shared/package.json packages/shared/
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate \
    && pnpm install --frozen-lockfile --filter "iot-saas-frontend..."

FROM node:20-alpine AS build
WORKDIR /repo
COPY --from=deps /repo ./
COPY packages packages
COPY frontend frontend
# Baked in at build time — Next.js inlines NEXT_PUBLIC_* vars into the client
# bundle, so it must be known before `next build`, not just at container run.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
WORKDIR /repo/frontend
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate \
    && pnpm build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S app && adduser -S app -G app
# The standalone output mirrors the workspace (next.config.mjs
# outputFileTracingRoot): node_modules at its root, the app in frontend/.
COPY --from=build --chown=app:app /repo/frontend/.next/standalone ./
COPY --from=build /repo/frontend/public ./frontend/public
COPY --from=build --chown=app:app /repo/frontend/.next/static ./frontend/.next/static
USER app

EXPOSE 3000
CMD ["node", "frontend/server.js"]
