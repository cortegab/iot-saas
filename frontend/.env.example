# iot-saas frontend configuration. Copy to frontend/.env.local and adjust as needed:
# cp .env.example .env.local
#
# All frontend env vars must be prefixed NEXT_PUBLIC_ to reach the browser bundle —
# never put a secret in this file, it ships to every client.

# Base URL of the FastAPI backend (see backend/.env.example's API_PORT).
NEXT_PUBLIC_API_URL=http://localhost:8000
