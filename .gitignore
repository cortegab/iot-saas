# Secrets / local config
#.env
#*.local

# Production secrets and host-generated config — unlike the dev .env files
# above (committed on purpose, dev-only placeholder values), these hold real
# credentials and must never be committed. See infra/PROD_DEPLOY.md.
infra/.env.prod
infra/emqx/emqx.prod.conf
infra/nginx/conf.d/*.conf
!infra/nginx/conf.d/*.conf.template

# Local override for a real secret that shouldn't join backend/.env's
# committed dev placeholders (e.g. a real SMTP password) — see
# backend/.env.local.example and config.py's Settings.model_config.
backend/.env.local

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
next-build-tmp-verify*/
next-env.d.ts
*.tsbuildinfo
.pnpm-store/

# Playwright E2E (frontend/e2e) — local reports/artifacts and per-developer
# credentials, not the specs themselves.
frontend/.env.test
frontend/e2e/.auth/
frontend/playwright-report/
frontend/test-results/

# OS / editor
.DS_Store
Thumbs.db

# Claude Code — local session state, agent worktrees, plans
.claude/
